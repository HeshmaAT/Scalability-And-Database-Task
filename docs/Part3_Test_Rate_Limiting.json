    {
      "name": "Create Link Rate Limit،",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get(\"access_token\");\r\n\r\nif (!token) {\r\n    throw new Error(\"Run Login first.\");\r\n}\r\n\r\nconst responses = [];\r\n\r\nfor (let i = 0; i < 61; i++) {\r\n    const response = await pm.sendRequest({\r\n        url: \"http://localhost:8080/api/links\",\r\n        method: \"POST\",\r\n        header: {\r\n            Authorization: `Bearer ${token}`,\r\n            Accept: \"application/json\",\r\n            \"Content-Type\": \"application/json\"\r\n        },\r\n        body: {\r\n            mode: \"raw\",\r\n            raw: JSON.stringify({\r\n                destination_url: \"https://example.com/rate-limit-test\"\r\n            })\r\n        }\r\n    });\r\n\r\n    responses.push(response);\r\n}\r\n\r\npm.test(\"First 60 requests returned 201\", () => {\r\n    pm.expect(responses.slice(0, 60).every(r => r.code === 201)).to.be.true;\r\n});\r\n\r\npm.test(\"Request 61 returned 429 with Retry-After\", () => {\r\n    const blocked = responses[60];\r\n\r\n    pm.expect(blocked.code).to.equal(429);\r\n\r\n    const retryAfter = blocked.headers.get(\"Retry-After\");\r\n\r\n    pm.expect(retryAfter).to.match(/^\\d+$/);\r\n    pm.expect(Number(retryAfter)).to.be.above(0);\r\n});\r\n\r\nconsole.log(\"Status codes:\", responses.map(r => r.code));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
