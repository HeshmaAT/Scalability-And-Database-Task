    {
      "name": "Testing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get(\"access_token\");\r\n\r\nif (!token) {\r\n    throw new Error(\"Run Login first to set access_token.\");\r\n}\r\n\r\nconst results = await Promise.allSettled(\r\n    Array.from({ length: 50 }, () => pm.sendRequest({\r\n        url: \"http://localhost:8080/api/links\",\r\n        method: \"POST\",\r\n        header: {\r\n            Authorization: `Bearer ${token}`,\r\n            Accept: \"application/json\",\r\n            \"Content-Type\": \"application/json\"\r\n        },\r\n        body: {\r\n            mode: \"raw\",\r\n            raw: JSON.stringify({\r\n                destination_url: \"https://example.com/concurrent-test\"\r\n            })\r\n        }\r\n    }))\r\n);\r\n\r\nconst created = results\r\n    .filter(result => result.status === \"fulfilled\" && result.value.code === 201)\r\n    .map(result => result.value.json().short_code);\r\n\r\npm.test(\"All 50 requests returned 201\", () => {\r\n    pm.expect(created).to.have.lengthOf(50);\r\n});\r\n\r\npm.test(\"All 50 codes are valid and distinct\", () => {\r\n    created.forEach(code => pm.expect(code).to.match(/^[A-Za-z0-9]{10}$/));\r\n    pm.expect(new Set(created).size).to.equal(50);\r\n});"
            ]
          }
        }
      ],
